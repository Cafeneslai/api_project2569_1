      ]
    },
    {
      "name": "4. Reviews & Rating",
      "item": [
        {
          "name": "Get reviews for a recipe",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/v1/recipes/1/reviews",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "v1", "recipes", "1", "reviews"]
            }
          },
          "response": []
