{
  "info": {
    "name": "Recipe Information System (Phase 3 Full Stack)",
    "description": "Postman Collection ครบทั้ง 10 Endpoints สำหรับระบบข้อมูลสูตรอาหาร (Phase 1, 2, 3)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Categories",
      "item": [
        {
          "name": "Get all categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/v1/categories",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "v1", "categories"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Recipes",
      "item": [
        {
          "name": "Get all recipes (with search & filter)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/v1/recipes?category_id=1&search=ต้ม",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "v1", "recipes"],
              "query": [
                { "key": "category_id", "value": "1" },
                { "key": "search", "value": "ต้ม" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get recipe by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/v1/recipes/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "v1", "recipes", "1"]
            }
          },
          "response": []
        },
        {
          "name": "Create a recipe",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"แกงเขียวหวานไก่\",\n  \"category_id\": 1,\n  \"cook_time_minutes\": 35,\n  \"ingredients\": \"เนื้อไก่ 300g, พริกแกงเขียวหวาน 50g, กะทิ 250ml, มะเขือเปราะ\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/v1/recipes",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "v1", "recipes"]
            }
          },
          "response": []
        },
        {
          "name": "Update a recipe",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"แกงเขียวหวานไก่สูตรพิเศษ\",\n  \"category_id\": 1,\n  \"cook_time_minutes\": 40,\n  \"ingredients\": \"เนื้อไก่ 350g, พริกแกงเขียวหวาน 60g, กะทิ 300ml, ใบโหระพา\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/v1/recipes/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "v1", "recipes", "1"]
            }
          },
          "response": []
        },
        {
          "name": "Delete a recipe",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/v1/recipes/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "v1", "recipes", "1"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Nutrition (External API Microservice)",
